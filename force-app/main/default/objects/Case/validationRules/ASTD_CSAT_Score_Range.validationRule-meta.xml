<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ASTD_CSAT_Score_Range</fullName>
    <active>true</active>
    <description>Validates that CSAT Score is between 1 and 5</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(ASTD_CSAT_Score__c)),
    OR(
        ASTD_CSAT_Score__c &lt; 1,
        ASTD_CSAT_Score__c &gt; 5
    )
)</errorConditionFormula>
    <errorMessage>CSAT Score must be between 1 and 5.</errorMessage>
</ValidationRule>